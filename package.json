{
  "name": "qr-joel",
  "type": "module",
  "version": "1.0.0",
  "main": "server.ts",
  "license": "MIT",
  "scripts": {
    "start": "tsx server.ts",
    "start:prod": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test --experimental-strip-types",
    "security:audit": "npm audit --audit-level=high",
    "security:sbom": "cyclonedx-npm --output-file sbom.cdx.json --omit dev",
    "security:ci": "npm run security:audit && npm run security:sbom",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/express": "^5.0.6",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "lefthook": "^2.1.10",
    "npm-check-updates": "^23.0.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
